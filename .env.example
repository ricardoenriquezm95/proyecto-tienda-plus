# =====================================================================================
# Tienda+ · variables del entorno local
# =====================================================================================

# --- Base de datos de catalog-service (contenedor catalog-db) ----------------------------
# Contraseña del administrador (sa) del SQL Server de catálogo
CATALOG_SA_PASSWORD=****
# Contraseña del usuario de la aplicación (catalog_user, solo accede a catalog_db)
CATALOG_DB_PASSWORD=****

# --- Base de datos de orders-service (contenedor orders-db) ------------------------------
ORDERS_SA_PASSWORD=****
ORDERS_DB_PASSWORD=****

# --- Seguridad de las APIs ---------------------------------------------------------------
# Cabecera X-Admin-Token para operaciones de administración y /health
ADMIN_TOKEN=****
# Cabecera X-Internal-Token para reserve/release entre servicios
INTERNAL_API_TOKEN=****

# --- Negocio -----------------------------------------------------------------------------
VAT_RATE=0.21
SEED_DEMO_DATA=true

# --- Puerto publicado en el host --------------------------------------------------------
# Única entrada al sistema (el gateway) para todas las APIs
GATEWAY_PORT=8080

# --- Imágenes (opcional) -----------------------------------------------------------------

IMAGE_PREFIX=tienda-plus
IMAGE_TAG=local
LOG_LEVEL=INFO
