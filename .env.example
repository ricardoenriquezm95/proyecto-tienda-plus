# =====================================================================================
# Tienda+ · variables del entorno local
#   1) Copia este archivo:  cp .env.example .env   (Windows: copy .env.example .env)
#   2) Cambia los valores. El archivo .env está en .gitignore: NUNCA lo subas al repo.
#
# Contraseñas de SQL Server: mínimo 8 caracteres con mayúsculas, minúsculas, números y
# símbolos. Evita los caracteres  '  "  $  (comillas o dólar) porque rompen el script SQL
# o la interpolación de Docker Compose.
# =====================================================================================

# --- Base de datos de catalog-service (contenedor catalog-db) ----------------------------
# Contraseña del administrador (sa) del SQL Server de catálogo
CATALOG_SA_PASSWORD=CambiaEsto_CatalogSa_2026!
# Contraseña del usuario de la aplicación (catalog_user, solo accede a catalog_db)
CATALOG_DB_PASSWORD=CambiaEsto_Catalog_2026!

# --- Base de datos de orders-service (contenedor orders-db) ------------------------------
ORDERS_SA_PASSWORD=CambiaEsto_OrdersSa_2026!
ORDERS_DB_PASSWORD=CambiaEsto_Orders_2026!

# --- Seguridad de las APIs ---------------------------------------------------------------
# Cabecera X-Admin-Token para operaciones de administración y /health
ADMIN_TOKEN=cambia-este-token-de-admin
# Cabecera X-Internal-Token para reserve/release entre servicios
INTERNAL_API_TOKEN=cambia-este-token-interno

# --- Negocio -----------------------------------------------------------------------------
VAT_RATE=0.21
SEED_DEMO_DATA=true

# --- Puerto publicado en el host --------------------------------------------------------
# Única entrada: API Gateway Nginx (los microservicios no publican puertos)
GATEWAY_PORT=8080

# --- Imágenes (opcional) -----------------------------------------------------------------
# Para usar las imágenes publicadas por la CI en lugar de construirlas:
#   IMAGE_PREFIX=ghcr.io/ricardoenriquezm95/tienda-plus   IMAGE_TAG=sha-xxxxxxx
#   docker compose pull catalog-service orders-service && docker compose up -d --no-build
IMAGE_PREFIX=tienda-plus
IMAGE_TAG=local
LOG_LEVEL=INFO
